{% extends 'base.html.twig' %}

{% block title %}Modifier {{ product.name }}{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<div class="min-h-screen bg-emerald-50/30 py-12 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-2xl mx-auto">
        
        {# Retour & Titre #}
        <a href="{{ path('app_dashboard') }}" class="group inline-flex items-center text-sm font-bold text-emerald-600 hover:text-emerald-800 mb-8 transition-all">
            <i data-lucide="chevron-left" class="w-5 h-5 mr-1 transition-transform group-hover:-translate-x-1"></i>
            Retour à l'inventaire
        </a>

        <div class="bg-white rounded-[2rem] shadow-xl shadow-emerald-900/5 border border-emerald-50 overflow-hidden">
            {# Header de la carte #}
            <div class="p-8 border-b border-emerald-50 bg-emerald-50/50 flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-black text-emerald-900">Modifier l'article</h1>
                    <p class="text-emerald-500 text-sm font-medium mt-1">Référence unique : <span class="bg-emerald-100 px-2 py-0.5 rounded text-emerald-700">#{{ product.id }}</span></p>
                </div>
                <div class="p-3 bg-white rounded-2xl shadow-sm text-emerald-500">
                    <i data-lucide="package-check" class="w-8 h-8"></i>
                </div>
            </div>

            {# Formulaire #}
            <form method="POST" action="{{ path('product_update', {'id': product.id}) }}" class="p-8 space-y-8">
                <div class="grid grid-cols-1 gap-8">
                    
                    {# Champ Nom #}
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-emerald-800 ml-1">Désignation du produit</label>
                        <div class="relative group">
                            <i data-lucide="tag" class="w-5 h-5 absolute left-4 top-3.5 text-emerald-300 group-focus-within:text-emerald-500 transition-colors"></i>
                            <input name="name" type="text" value="{{ product.name }}"
                                   class="w-full pl-12 pr-4 py-3.5 bg-emerald-50/30 border border-emerald-100 rounded-2xl focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 outline-none transition-all font-semibold text-emerald-900">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        {# Champ Prix #}
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-emerald-800 ml-1">Prix de vente (DH)</label>
                            <div class="relative">
                                <input name="price" type="number" step="0.01" value="{{ product.price }}"
                                       class="w-full px-4 py-3.5 bg-emerald-50/30 border border-emerald-100 rounded-2xl focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 outline-none transition-all font-mono font-bold text-emerald-900">
                                <span class="absolute right-4 top-3.5 text-emerald-400 text-sm font-bold uppercase">MAD</span>
                            </div>
                        </div>
                        
                        {# Champ Stock #}
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-emerald-800 ml-1">Unités en stock</label>
                            <div class="relative group">
                                <i data-lucide="layers" class="w-5 h-5 absolute left-4 top-3.5 text-emerald-300 group-focus-within:text-emerald-500 transition-colors"></i>
                                <input name="quantity" type="number" value="{{ product.quantity }}"
                                       class="w-full pl-12 pr-4 py-3.5 bg-emerald-50/30 border border-emerald-100 rounded-2xl focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 outline-none transition-all font-bold text-emerald-900">
                            </div>
                        </div>
                    </div>

                    {# Champ Description #}
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-emerald-800 ml-1">Description complète</label>
                        <textarea name="description" rows="4" 
                                  class="w-full px-5 py-4 bg-emerald-50/30 border border-emerald-100 rounded-2xl focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 outline-none transition-all font-medium text-emerald-900 placeholder-emerald-300">{{ product.description }}</textarea>
                    </div>
                </div>

                {# Actions Footer #}
                <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-8 border-t border-emerald-50">
                    <button type="button" onclick="history.back()" 
                            class="w-full sm:w-auto px-8 py-3.5 rounded-2xl text-emerald-600 hover:bg-emerald-50 font-bold transition-all active:scale-95">
                        Annuler
                    </button>
                    
                    <button class="w-full sm:w-auto px-8 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black shadow-lg shadow-emerald-200 transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                        <i data-lucide="save" class="w-5 h-5"></i>
                        Mettre à jour l'article
                    </button>
                </div>
            </form>
        </div>
        
        {# Info Footer #}
        <p class="mt-8 text-center text-emerald-400 text-xs font-bold uppercase tracking-widest">
            Dernière modification : {{ "now"|date("d/m/Y H:i") }}
        </p>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
{% endblock %}