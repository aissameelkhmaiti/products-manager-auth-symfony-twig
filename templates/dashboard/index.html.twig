{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord - Inventaire{% endblock %}

{% block body %}
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<div class="min-h-screen bg-emerald-50/30 py-8 px-4 sm:px-6 lg:px-8 font-sans text-emerald-950">
    <div class="max-w-6xl mx-auto">

        {# HEADER #}
        <div class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                <div class="bg-emerald-600 p-3 rounded-2xl shadow-lg shadow-emerald-200">
                    <i data-lucide="layout-dashboard" class="w-8 h-8 text-white"></i>
                </div>
                <div>
                    <h1 class="text-3xl font-extrabold tracking-tight text-emerald-900">Catalogue Produits</h1>
                    <p class="text-emerald-600/70 mt-1 font-medium">Gestion d'inventaire éco-responsable et précise.</p>
                </div>
            </div>

            <div class="flex items-center gap-4">
                {# STATS QUICK VIEW #}
                <div class="flex items-center gap-3 bg-white p-2 pr-5 rounded-2xl shadow-sm border border-emerald-100">
                    <div class="bg-emerald-100 p-2.5 rounded-xl text-emerald-600">
                        <i data-lucide="package" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <p class="text-[10px] text-emerald-500 uppercase font-bold tracking-widest leading-none mb-1">Total Stock</p>
                        <p class="text-xl font-black leading-none text-emerald-900">{{ totalProducts }}</p>
                    </div>
                </div>

                {# BOUTON DECONNEXION #}
                <a href="{{ path('app_logout') }}" 
                   class="flex items-center gap-2 bg-white hover:bg-red-50 text-emerald-700 hover:text-red-600 px-5 py-3 rounded-2xl border border-emerald-100 hover:border-red-100 transition-all font-bold shadow-sm active:scale-95 group"
                   title="Se déconnecter">
                    <i data-lucide="log-out" class="w-4 h-4 transition-transform group-hover:-translate-x-1"></i>
                    <span class="hidden sm:inline">Quitter</span>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            {# FORMULAIRE (Col 1) #}
            <div class="lg:col-span-1">
                <div class="bg-white p-8 rounded-3xl shadow-xl shadow-emerald-900/5 border border-emerald-50 sticky top-8">
                    <div class="flex items-center gap-3 mb-8">
                        <div class="w-2 h-8 bg-emerald-500 rounded-full"></div>
                        <h2 class="text-xl font-bold text-emerald-900">Ajouter un article</h2>
                    </div>

                    <form method="POST" action="{{ path('product_create') }}" class="space-y-5">
                        <div>
                            <label class="block text-sm font-bold text-emerald-800 mb-1.5 ml-1">Nom du produit</label>
                            <input name="name" type="text" placeholder="Ex: Bureau en Chêne"
                                   class="w-full border-emerald-100 rounded-xl p-3.5 bg-emerald-50/30 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 transition-all outline-none border font-medium" required>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-bold text-emerald-800 mb-1.5 ml-1">Prix (DH)</label>
                                <input name="price" type="number" step="0.01" placeholder="0.00"
                                       class="w-full border-emerald-100 rounded-xl p-3.5 bg-emerald-50/30 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 transition-all outline-none border font-mono font-bold" required>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-emerald-800 mb-1.5 ml-1">Quantité</label>
                                <input name="quantity" type="number" placeholder="0"
                                       class="w-full border-emerald-100 rounded-xl p-3.5 bg-emerald-50/30 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 transition-all outline-none border font-bold">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-emerald-800 mb-1.5 ml-1">Description</label>
                            <textarea name="description" rows="3" placeholder="Caractéristiques, dimensions..."
                                      class="w-full border-emerald-100 rounded-xl p-3.5 bg-emerald-50/30 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 transition-all outline-none border font-medium"></textarea>
                        </div>

                        <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-emerald-200 transition-all active:scale-[0.98] flex items-center justify-center gap-3 mt-4">
                            <i data-lucide="sparkles" class="w-5 h-5"></i>
                            Ajouter au catalogue
                        </button>
                    </form>
                </div>
            </div>

            {# LISTE (Col 2-3) #}
            <div class="lg:col-span-2">
                <div class="bg-white rounded-3xl shadow-xl shadow-emerald-900/5 border border-emerald-50 overflow-hidden">
                    <div class="p-8 border-b border-emerald-50 flex justify-between items-center bg-white/50 backdrop-blur-sm">
                        <div>
                            <h2 class="text-xl font-extrabold text-emerald-900">Articles en Stock</h2>
                            <p class="text-emerald-500 text-xs font-semibold">Mise à jour automatique</p>
                        </div>
                        <div class="flex gap-2">
                             <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
                             <span class="w-3 h-3 rounded-full bg-emerald-200"></span>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-emerald-50/50">
                                    <th class="px-8 py-5 text-[11px] font-black text-emerald-600 uppercase tracking-[0.2em] border-b border-emerald-50">Désignation</th>
                                    <th class="px-8 py-5 text-[11px] font-black text-emerald-600 uppercase tracking-[0.2em] border-b border-emerald-50">Prix Unitaire</th>
                                    <th class="px-8 py-5 text-[11px] font-black text-emerald-600 uppercase tracking-[0.2em] border-b border-emerald-50">Disponibilité</th>
                                    <th class="px-8 py-5 text-[11px] font-black text-emerald-600 uppercase tracking-[0.2em] border-b border-emerald-50 text-right">Gestion</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-emerald-50">
                                {% for product in products %}
                                <tr class="hover:bg-emerald-50/40 transition-colors group">
                                    <td class="px-8 py-6">
                                        <div class="font-bold text-emerald-900 group-hover:text-emerald-600 transition-colors">{{ product.name }}</div>
                                        <div class="text-xs text-emerald-400 font-medium italic mt-0.5 truncate max-w-[200px]">{{ product.description|default('Aucun détail spécifié') }}</div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <span class="font-mono font-black text-emerald-950 bg-emerald-50 px-3 py-1.5 rounded-lg text-sm">
                                            {{ product.price|number_format(2, ',', ' ') }} <span class="text-[10px] text-emerald-500">DH</span>
                                        </span>
                                    </td>
                                    <td class="px-8 py-6">
                                        {% if product.quantity > 0 %}
                                            <div class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full text-[11px] font-black uppercase bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200">
                                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                                {{ product.quantity }} en stock
                                            </div>
                                        {% else %}
                                            <div class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full text-[11px] font-black uppercase bg-red-50 text-red-600 ring-1 ring-red-100">
                                                <span class="w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.5)]"></span>
                                                Épuisé
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="px-8 py-6 text-right">
                                        <div class="flex justify-end gap-3 opacity-40 group-hover:opacity-100 transition-opacity">
                                            <a href="{{ path('product_edit', {'id': product.id}) }}" 
                                               class="p-2.5 bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white rounded-xl transition-all shadow-sm" title="Modifier">
                                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                                            </a>
                                            <form method="POST" action="{{ path('product_delete', {'id': product.id}) }}" 
                                                  class="inline" onsubmit="return confirm('Voulez-vous retirer ce produit du catalogue ?')">
                                                <button class="p-2.5 bg-red-50 text-red-400 hover:bg-red-600 hover:text-white rounded-xl transition-all shadow-sm" title="Supprimer">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="px-8 py-20 text-center">
                                        <div class="flex flex-col items-center">
                                            <div class="bg-emerald-50 p-6 rounded-full mb-6 border-4 border-white shadow-inner">
                                                <i data-lucide="leaf" class="w-12 h-12 text-emerald-200"></i>
                                            </div>
                                            <p class="text-emerald-900 font-black text-lg tracking-tight">Le catalogue est vierge.</p>
                                            <p class="text-emerald-500 text-sm mt-1">Cultivez votre inventaire en ajoutant un premier produit.</p>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    
                    {# FOOTER TABLE #}
                    <div class="p-6 bg-emerald-50/30 border-t border-emerald-50 text-center">
                         <p class="text-[10px] font-bold text-emerald-400 uppercase tracking-[0.3em]">Fin de liste • Système certifié</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialisation des icônes Lucide avec configuration
    lucide.createIcons();
</script>
{% endblock %}